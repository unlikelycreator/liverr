# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/liverr
# Optional: enables AI extraction. Without it the offline rule parser is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Passcode for the app login. Leave empty to disable login (not recommended once deployed).
ACCESS_PASSCODE=
# Long random string used to sign login tokens
JWT_SECRET=
DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata
# Comma-separated allowed frontend origins (empty = allow all)
CORS_ORIGINS=
PORT=4000
